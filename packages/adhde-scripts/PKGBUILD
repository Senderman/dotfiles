package() {
    cd "${srcdir}"
    for i in *.sh; do
      install -Dm755 "$i" "${pkgdir}/usr/bin/${i%.sh}"
    done
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}

