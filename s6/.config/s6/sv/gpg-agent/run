#!/usr/bin/execlineb -P

fdmove -c 2 1

importas -S HOME
importas -SD ${HOME}/.config XDG_CONFIG_HOME
envfile ${XDG_CONFIG_HOME}/s6/config/gpg-agent.conf

multisubstitute {
    importas -Su DEFAULT_CACHE_TTL
    importas -Su MAX_CACHE_TTL
}

gpg-agent
--default-cache-ttl ${DEFAULT_CACHE_TTL}
--max-cache-ttl ${MAX_CACHE_TTL}
--disable-scdaemon
--daemon
sleep infinity

